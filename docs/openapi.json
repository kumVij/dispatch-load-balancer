  "components": {
    "schemas": {
      "VehicleRequest": {
        "required": [
          "capacity",
          "currentAddress",
          "currentLatitude",
          "currentLongitude",
          "vehicleId"
        ],
        "type": "object",
        "properties": {
          "vehicleId": {
            "maxLength": 64,
            "minLength": 0,
            "pattern": "^[A-Za-z0-9._-]*$",
            "type": "string",
            "description": "Unique vehicle id",
            "example": "VEH001"
          },
          "capacity": {
            "type": "number",
            "description": "Maximum total load the vehicle can carry",
            "format": "double",
            "example": 100
          },
          "currentLatitude": {
            "maximum": 90,
            "exclusiveMaximum": false,
            "minimum": -90,
            "exclusiveMinimum": false,
            "type": "number",
            "description": "Current latitude (-90 to 90)",
            "format": "double",
            "example": 12.9716
          },
          "currentLongitude": {
            "maximum": 180,
            "exclusiveMaximum": false,
            "minimum": -180,
            "exclusiveMinimum": false,
            "type": "number",
            "description": "Current longitude (-180 to 180)",
            "format": "double",
            "example": 77.6413
          },
          "currentAddress": {
            "maxLength": 255,
            "minLength": 0,
            "type": "string",
            "example": "Indiranagar, Bangalore, Karnataka, India"
          }
        }
      },
      "VehicleDto": {
        "type": "object",
        "properties": {
          "vehicleId": {
            "type": "string"
          },
          "capacity": {
            "type": "number",
            "format": "double"
          },
          "currentLatitude": {
            "type": "number",
            "format": "double"
          },
          "currentLongitude": {
            "type": "number",
            "format": "double"
          },
          "currentAddress": {
            "type": "string"
          }
        }
      },
      "OrderRequest": {
        "required": [
          "address",
          "latitude",
          "longitude",
          "orderId",
          "packageWeight",
          "priority"
        ],
        "type": "object",
        "properties": {
          "orderId": {
            "maxLength": 64,
            "minLength": 0,
            "pattern": "^[A-Za-z0-9._-]*$",
            "type": "string",
            "description": "Unique order id",
            "example": "ORD001"
          },
          "latitude": {
            "maximum": 90,
            "exclusiveMaximum": false,
            "minimum": -90,
            "exclusiveMinimum": false,
            "type": "number",
            "description": "Drop-point latitude (-90 to 90)",
            "format": "double",
            "example": 12.9716
          },
          "longitude": {
            "maximum": 180,
            "exclusiveMaximum": false,
            "minimum": -180,
            "exclusiveMinimum": false,
            "type": "number",
            "description": "Drop-point longitude (-180 to 180)",
            "format": "double",
            "example": 77.5946
          },
          "address": {
            "maxLength": 255,
            "minLength": 0,
            "type": "string",
            "example": "MG Road, Bangalore, Karnataka, India"
          },
          "packageWeight": {
            "type": "number",
            "description": "Package weight, same unit as vehicle capacity",
            "format": "double",
            "example": 10
          },
          "priority": {
            "type": "string",
            "example": "HIGH",
            "enum": [
              "HIGH",
              "MEDIUM",
              "LOW"
            ]
          }
        }
      },
      "OrderDto": {
        "type": "object",
        "properties": {
          "orderId": {
            "type": "string"
          },
          "latitude": {
            "type": "number",
            "format": "double"
          },
          "longitude": {
            "type": "number",
            "format": "double"
          },
          "address": {
            "type": "string"
          },
          "packageWeight": {
            "type": "number",
            "format": "double"
          },
          "priority": {
            "type": "string",
            "enum": [
              "HIGH",
              "MEDIUM",
              "LOW"
            ]
          }
        }
      },
      "VehicleBatchRequest": {
        "required": [
          "vehicles"
        ],
        "type": "object",
        "properties": {
          "vehicles": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/VehicleRequest"
            }
          }
        }
      },
      "ApiResponse": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string"
          },
          "status": {
            "type": "string"
          }
        }
      },
      "AssignedVehicleDto": {
        "type": "object",
        "properties": {
          "vehicleId": {
            "type": "string"
          },
          "capacity": {
            "type": "number",
            "format": "double"
          },
          "totalLoad": {
            "type": "number",
            "format": "double"
          },
          "totalDistance": {
            "type": "string"
          },
          "totalDistanceKm": {
            "type": "number",
            "format": "double"
          },
          "assignedOrders": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/OrderDto"
            }
          }
        }
      },
      "DispatchPlanResponse": {
        "type": "object",
        "properties": {
          "dispatchPlan": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AssignedVehicleDto"
            }
          },
          "unassignedOrders": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/UnassignedOrderDto"
            }
          }
        }
      },
      "PlanDetailResponse": {
        "type": "object",
        "properties": {
          "metadata": {
            "$ref": "#/components/schemas/PlanMetadataDto"
          },
          "plan": {
            "$ref": "#/components/schemas/DispatchPlanResponse"
          }
        }
      },
      "PlanMetadataDto": {
        "type": "object",
        "properties": {
          "planId": {
            "type": "string"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "strategy": {
            "type": "string"
          },
          "totalOrders": {
            "type": "integer",
            "format": "int32"
          },
          "assignedOrders": {
            "type": "integer",
            "format": "int32"
          },
          "unassignedOrders": {
            "type": "integer",
            "format": "int32"
          },
          "totalDistanceKm": {
            "type": "number",
            "format": "double"
          },
          "fleetUtilizationPercent": {
            "type": "number",
            "format": "double"
          },
          "computationMillis": {
            "type": "integer",
            "format": "int64"
          }
        }
